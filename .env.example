# NetBox
NETBOX_URL=http://NETBOX_HOST:8000
NETBOX_TOKEN=REPLACE_WITH_NETBOX_TOKEN

# Security Onion SSH target
SO_HOST=SECURITY_ONION_HOST
SO_PORT=22
SO_USER=netbox-sync
SO_SSH_KEY=/home/bridge/.ssh/id_ed25519

# Passive identity reader
SO_READER_ENABLED=true
SO_READER_HOURS=24
SO_READER_HELPER=/usr/local/sbin/netbox-so-observe

# Mapping publisher
SO_REMOTE_TEMP=/home/netbox-sync/ip-descriptions.csv.tmp
SO_HELPER=/usr/local/sbin/update-so-ip-mappings.sh

# Topology / coverage
TOPOLOGY_ENABLED=true
TOPOLOGY_HOURS=24
TOPOLOGY_SENSOR_CONFIG=/config/sensors.yaml
TOPOLOGY_OUTPUT_DIR=/data/topology
TOPOLOGY_INCLUDE_IPV6=false
TOPOLOGY_STATE_FILE=/data/topology/topology-state.json
TOPOLOGY_VISUAL_MIN_CONNECTIONS=5
TOPOLOGY_VISUAL_MIN_BYTES=51200
TOPOLOGY_VISUAL_MAX_EDGES=1000

# Bridge output / schedule
OUTPUT_FILE=/data/ip-descriptions.csv
SYNC_INTERVAL=900
DRY_RUN=true
LOG_LEVEL=INFO
